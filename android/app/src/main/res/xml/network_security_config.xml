<?xml version="1.0" encoding="utf-8"?>
<!-- Security (spec section 8): HTTPS only, system CAs.
     For production, enable certificate pinning for the API domain:
     uncomment the domain-config block below and set real SHA-256 pin(s). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

